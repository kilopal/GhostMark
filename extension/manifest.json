{
  "manifest_version": 3,
  "name": "GhostMark",
  "version": "0.4.0",
  "description": "Strip AI provenance watermarks locally in your browser.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.huggingface.co/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
