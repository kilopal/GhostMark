{
  "manifest_version": 3,
  "name": "GhostMark",
  "version": "0.4.0",
  "description": "Strip AI provenance watermarks locally in your browser.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
